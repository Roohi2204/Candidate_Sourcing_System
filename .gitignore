# ==========================================
# TalentBridge Root .gitignore
# ==========================================

# ------------------------------------------
# Python & Backend
# ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
venv*/
env/
env*/
.venv/
.venv*/
ENV/
env.bak/
venv.bak/

# SQLite & Local DB Files
*.sqlite
*.sqlite3
*.db

# Uploaded Files & Temporary Resumes (Keep directory structure)
backend/uploads/*
!backend/uploads/.gitkeep

# ------------------------------------------
# Node.js & Frontend (Next.js)
# ------------------------------------------
node_modules/
frontend/node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
.next/
frontend/.next/
out/
frontend/out/
frontend/build/

# Next.js & Turbopack cache
.turbo/
frontend/.turbo/

# TypeScript build info
*.tsbuildinfo
frontend/next-env.d.ts

# NPM / Yarn / PNPM debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
backend/.env
frontend/.env.local

# ------------------------------------------
# IDEs & System Files
# ------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# Testing & Coverage
coverage/
frontend/coverage/
.pytest_cache/
htmlcov/

# Vercel deployment
.vercel/
frontend/.vercel/
